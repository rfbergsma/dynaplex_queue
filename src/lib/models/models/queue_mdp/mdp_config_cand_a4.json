/**
 * Candidate A scaled to 4 job types / 4 server pools.
 *
 * Identical design principle to mdp_config_cand_a_antidue (3 types), which won
 * the headroom screening with min(FIFO/RVI, CMU/RVI) = 1.49 at load 2.0:
 *
 *   - chain topology: pool k serves {k, k+1}; the last pool is dedicated
 *   - cost rates INCREASE with the type index
 *   - deadlines also INCREASE, i.e. they are ANTI-ALIGNED with cost:
 *     the cheapest type is the most urgent and has no alternative server
 *   - service rates decrease with the index
 *
 * c*mu for pool 0: type 0 -> 50*1.2 = 60 vs type 1 -> 75*1.1 = 82.5, so the
 * myopic index pulls pool 0 away from the only type it alone can rescue.
 *
 * RVI is out of reach at 4 types with a wide truncation; this cell is judged
 * against FIFO and c-mu, with the 3-type instance supplying the RVI-verified
 * anchor for the same structural family.
 */
{
    "id": "queue_mdp",
    "discount_factor": 1.0,
    "reward_type": 4,
    "k_servers": 4,
    "n_jobs": 4,
    "tick_rate": 1.0,
    "arrival_rates": [ 0.20, 0.20, 0.20, 0.15 ],
    "cost_rates":    [ 50.0, 75.0, 100.0, 200.0 ],
    "due_times":     [ 3.0,  4.0,  6.0,   9.0   ],
    "server_type_0": {
        "servers": 1,
        "can_serve": [ 0, 1 ],
        "service_rates": [ 1.2, 1.1 ]
    },
    "server_type_1": {
        "servers": 1,
        "can_serve": [ 1, 2 ],
        "service_rates": [ 1.1, 1.0 ]
    },
    "server_type_2": {
        "servers": 1,
        "can_serve": [ 2, 3 ],
        "service_rates": [ 1.0, 0.9 ]
    },
    "server_type_3": {
        "servers": 1,
        "can_serve": [ 3 ],
        "service_rates": [ 0.9 ]
    }
}
