/**
 * Candidate B: PURE fraction-late (equal weights) with anti-aligned speeds.
 *
 * Design intent: make both standard heuristics fail by construction.
 *
 *   - All cost rates are EQUAL, so under reward_type 4 the objective is the
 *     unweighted fraction of customers served late.  Cost carries no signal.
 *   - Consequently c-mu degenerates to a pure mu-ordering (fastest first),
 *     which is completely deadline-blind.
 *   - Service rates are ANTI-ALIGNED with urgency: the tight-deadline type 0
 *     is served SLOWLY (0.7) while the relaxed type 1 is served fast (1.3),
 *     so mu-ordering actively prefers the job that is not at risk.
 *   - FIFO is also misled: type 2 has the loosest deadline (D=9), so its jobs
 *     legitimately accumulate the most age and look "oldest" in absolute
 *     terms, drawing FIFO away from the urgent type 0.
 *
 * The correct policy must reason about SLACK (D - W), which is exactly the
 * quantity neither heuristic represents.  Expected to give the largest gap
 * of the four candidates.
 */
{
    "id": "queue_mdp",
    "discount_factor": 1.0,
    "reward_type": 4,
    "k_servers": 3,
    "n_jobs": 3,
    "tick_rate": 1.0,
    "arrival_rates": [ 0.20, 0.20, 0.15 ],
    "cost_rates":    [ 100.0, 100.0, 100.0 ],
    "due_times":     [ 3.0,   6.0,   9.0   ],
    "server_type_0": {
        "servers": 1,
        "can_serve": [ 0, 1 ],
        "service_rates": [ 0.7, 1.3 ]
    },
    "server_type_1": {
        "servers": 1,
        "can_serve": [ 1, 2 ],
        "service_rates": [ 1.3, 1.3 ]
    },
    "server_type_2": {
        "servers": 1,
        "can_serve": [ 2 ],
        "service_rates": [ 1.3 ]
    }
}
