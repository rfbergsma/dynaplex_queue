/**
 * Candidate A scaled to 6 job types / 6 server pools.
 *
 * Same structural family as mdp_config_cand_a_antidue (3 types) and
 * mdp_config_cand_a4 (4 types): a chain in which pool k serves {k, k+1}, the
 * last pool is dedicated, cost rates increase with the type index, and the
 * deadlines are ANTI-ALIGNED with cost -- the cheapest type is the most
 * urgent and is served by exactly one pool.
 *
 * This is the deliberate contrast with mdp_config_large_6j5s.json, where cost,
 * service rate and deadline all move monotonically together and therefore make
 * the c*mu ordering coincide with the urgency ordering; on that instance c-mu
 * came within 3% of the learned policy.  Here the alignment is broken, so a
 * myopic index rule should give away substantially more.
 *
 * Load check at load=2: total arrival 2.30 against ~6 pools of capacity ~1.0,
 * and the tightest single-server constraint is type 0 (only pool 0, rate 1.2,
 * lambda 0.40 -> rho 0.33).  Comfortably stable.
 */
{
    "id": "queue_mdp",
    "discount_factor": 1.0,
    "reward_type": 4,
    "k_servers": 6,
    "n_jobs": 6,
    "tick_rate": 1.0,
    "arrival_rates": [ 0.20, 0.20, 0.20, 0.20, 0.20, 0.15 ],
    "cost_rates":    [ 50.0, 75.0, 100.0, 125.0, 150.0, 200.0 ],
    "due_times":     [ 3.0,  4.0,  5.0,   6.0,   7.0,   9.0   ],
    "server_type_0": {
        "servers": 1,
        "can_serve": [ 0, 1 ],
        "service_rates": [ 1.2, 1.1 ]
    },
    "server_type_1": {
        "servers": 1,
        "can_serve": [ 1, 2 ],
        "service_rates": [ 1.1, 1.0 ]
    },
    "server_type_2": {
        "servers": 1,
        "can_serve": [ 2, 3 ],
        "service_rates": [ 1.0, 0.9 ]
    },
    "server_type_3": {
        "servers": 1,
        "can_serve": [ 3, 4 ],
        "service_rates": [ 0.9, 0.8 ]
    },
    "server_type_4": {
        "servers": 1,
        "can_serve": [ 4, 5 ],
        "service_rates": [ 0.8, 0.7 ]
    },
    "server_type_5": {
        "servers": 1,
        "can_serve": [ 5 ],
        "service_rates": [ 0.7 ]
    }
}
